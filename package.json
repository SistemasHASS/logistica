{
  "name": "logistica",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/update-version.js && ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev": "ng serve --configuration=development",
    "update-version": "node scripts/update-version.js",
    "build": "node scripts/update-version.js && ng build --configuration=production && node scripts/register-deployment.js",
    "build:prod": "node scripts/update-version.js && ng build --configuration=production && node scripts/register-deployment.js",
    "build:dev": "node scripts/update-version.js && ng build --configuration=development && node scripts/register-deployment.js --skip",
    "build:prod-api": "node scripts/git-commit-and-build.js && node scripts/update-version.js && ng build --configuration=prod-api && node scripts/register-deployment.js && node scripts/register-deployment.js --api=LOGISTICA",
    "build:no-register": "node scripts/update-version.js && ng build --configuration=prod-api",
    "register-deployment": "node scripts/register-deployment.js",
    "build-with-env": "node scripts/build-with-env.js",
    "git-commit": "node scripts/git-commit-and-build.js",
    "docs": "node scripts/generate-docs.js",
    "docs:backend": "powershell -ExecutionPolicy Bypass -File ../api_logistica/scripts/generate-docs-backend.ps1",
    "docs:all": "npm run docs && npm run docs:backend",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-to-server.ps1",
    "deploy:full": "npm run build:prod-api && npm run deploy",
    "deploy:logistica": "powershell -ExecutionPolicy Bypass -File scripts/deploy-full.ps1 -VersionApi LOGISTICA",
    "deploy:maestra": "powershell -ExecutionPolicy Bypass -File scripts/deploy-full.ps1 -VersionApi MAESTRA",
    "version:patch": "node scripts/version-patch.js",
    "version:minor": "node scripts/version-minor.js",
    "version:major": "node scripts/version-major.js",
    "version:check": "type src/assets/version.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.6",
    "@angular/common": "^20.3.6",
    "@angular/compiler": "^20.3.6",
    "@angular/core": "^20.3.6",
    "@angular/forms": "^20.3.6",
    "@angular/platform-browser": "^20.3.6",
    "@angular/platform-browser-dynamic": "^20.3.6",
    "@angular/router": "^20.3.6",
    "@angular/service-worker": "^20.3.6",
    "@primeuix/themes": "^2.0.0",
    "@tensorflow-models/universal-sentence-encoder": "^1.3.3",
    "@tensorflow/tfjs": "^4.12.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.5.1",
    "dexie": "^4.0.11",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "moment": "^2.30.1",
    "pdfmake": "^0.2.20",
    "primeicons": "^7.0.0",
    "primeng": "^20.3.0",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.15.10",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.6",
    "@angular/cli": "^20.3.6",
    "@angular/compiler-cli": "^20.3.6",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "@types/pdfmake": "^0.2.12",
    "@types/xlsx": "^0.0.35",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "^5.8.2"
  }
}